<div class="modal fade show" tabindex="-1" style="display: @(IsVisible ? "block" : "none"); background-color: rgba(0, 0, 0, 0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Validation Errors</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @if (EditContext != null)
                {
                    <CascadingValue Value="EditContext">
                        <ValidationSummary />
                    </CascadingValue>
                }
                else
                {
                    <p>No validation context provided.</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="Close">OK</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EditContext? EditContext { get; set; }

    private bool IsVisible { get; set; }

    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        IsVisible = false;
    }
}
